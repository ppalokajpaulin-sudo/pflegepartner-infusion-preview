{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "quiz.pflegepartner.ch" }],
      "destination": "https://vitamine.pflegepartner.ch/quiz",
      "permanent": false
    },
    {
      "source": "/start",
      "destination": "/quiz?bereich=wahl",
      "permanent": false
    },
    {
      "source": "/pflege-check",
      "destination": "/quiz?bereich=pflege",
      "permanent": false
    },
    {
      "source": "/spitex-check",
      "destination": "/quiz?bereich=pflege",
      "permanent": false
    },
    {
      "source": "/spitex",
      "destination": "/quiz?bereich=pflege",
      "permanent": false
    },
    {
      "source": "/check",
      "destination": "/quiz",
      "permanent": false
    },
    {
      "source": "/infusions-check",
      "destination": "https://pflegepartner.ch/infusionen/",
      "permanent": false
    },
    {
      "source": "/quiz",
      "has": [{ "type": "query", "key": "bereich", "value": "infusion" }],
      "destination": "https://pflegepartner.ch/infusionen/",
      "permanent": false
    },
    {
      "source": "/:slug(vitamine|vital|glutathion|recovery|immune|nad|beauty|danke)",
      "destination": "https://pflegepartner.ch/infusionen/",
      "permanent": false
    },
    {
      "source": "/:slug(vitamine|vital|glutathion|recovery|immune|nad|beauty|danke).html",
      "destination": "https://pflegepartner.ch/infusionen/",
      "permanent": false
    },
    {
      "source": "/infusion-:rest",
      "destination": "https://pflegepartner.ch/infusionen/",
      "permanent": false
    },
    {
      "source": "/",
      "missing": [{ "type": "host", "value": "leads.pflegepartner.ch" }],
      "destination": "https://pflegepartner.ch/infusionen/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "leads.pflegepartner.ch" }],
      "destination": "https://pflegepartner-leads-production.up.railway.app/"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "leads.pflegepartner.ch" }],
      "destination": "https://pflegepartner-leads-production.up.railway.app/:path*"
    },
    {
      "source": "/quiz",
      "has": [{ "type": "query", "key": "bereich", "value": "pflege" }],
      "destination": "/views/pflege.html"
    },
    {
      "source": "/quiz",
      "destination": "/views/wahl.html"
    }
  ]
}
