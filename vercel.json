        }
      ],
      "destination": "/nad.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "beauty.pflegepartner.ch"
        }
      ],
      "destination": "/beauty.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "vitamine.pflegepartner.ch"
        }
      ],
      "destination": "/vitamine.html"
    },
    {
      "source": "/quiz",
      "has": [
        {
          "type": "query",
          "key": "bereich",
          "value": "pflege"
        }
      ],
      "destination": "/views/pflege.html"
    },
    {
      "source": "/quiz",
      "has": [
        {
          "type": "query",
          "key": "bereich",
          "value": "wahl"
        }
      ],
      "destination": "/views/wahl.html"
    },
    {
      "source": "/quiz",
      "destination": "/quiz.html"
    },
    {
      "source": "/",
      "destination": "/vitamine.html"
    }
