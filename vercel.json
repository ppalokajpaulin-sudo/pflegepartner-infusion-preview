        {
          "type": "host",
          "value": "leads.pflegepartner.ch"
        }
      ],
      "destination": "https://pflegepartner-leads-production.up.railway.app/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "vital.pflegepartner.ch"
        }
      ],
      "destination": "/vital.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "glutathion.pflegepartner.ch"
        }
      ],
      "destination": "/glutathion.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "recovery.pflegepartner.ch"
        }
      ],
      "destination": "/recovery.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "immune.pflegepartner.ch"
        }
      ],
      "destination": "/immune.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
