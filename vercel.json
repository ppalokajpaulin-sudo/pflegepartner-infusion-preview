{
  "redirects": [
    {
      "source": "/start",
      "destination": "/quiz?bereich=wahl",
      "permanent": false
    },
    {
      "source": "/pflege-check",
      "destination": "/quiz?bereich=pflege",
      "permanent": false
    },
    {
      "source": "/spitex-check",
      "destination": "/quiz?bereich=pflege",
      "permanent": false
    },
    {
      "source": "/spitex",
      "destination": "/quiz?bereich=pflege",
      "permanent": false
    },
    {
      "source": "/check",
