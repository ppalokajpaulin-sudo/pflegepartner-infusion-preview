    },
    {
      "source": "/infusions-check",
      "destination": "/quiz?bereich=infusion",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "quiz.pflegepartner.ch"
        }
      ],
      "destination": "https://vitamine.pflegepartner.ch/quiz",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
